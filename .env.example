# Copy this file to .env.local and fill in the values from THIS CLIENT'S
# OWN Supabase project (Settings -> API). Every client gets their own
# Supabase project — never share one project's keys across clients.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Shown as a fallback company name before System Settings has loaded
# (e.g. on the login screen). Cosmetic only — the real branding lives
# in the system_settings table and is editable in-app.
VITE_DEFAULT_COMPANY_NAME=AGS Decorating & Refurbishment Services
